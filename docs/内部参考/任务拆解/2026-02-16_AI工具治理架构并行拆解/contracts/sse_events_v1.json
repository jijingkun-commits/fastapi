{
  "version": "v1",
  "task_key": "PP-20260216-TOOL-GOVERNANCE",
  "frozen_at": "2026-02-16",
  "owner": "WS-00",
  "consumers_readonly": [
    "WS-01",
    "WS-02",
    "WS-03",
    "WS-G1"
  ],
  "compatibility": {
    "policy": "append_optional_only",
    "notes": "required 字段语义不可变更，仅允许追加 optional 字段"
  },
  "events": {
    "done": {
      "required": [
        "type",
        "data.thread_id",
        "data.message_id"
      ],
      "optional": [
        "node",
        "data.final_content",
        "data.tool_call_id"
      ],
      "constraints": {
        "type": {
          "enum": [
            "done"
          ]
        },
        "data.tool_call_id": {
          "type": "string",
          "required_in_phase": "phase3_optional"
        }
      }
    },
    "result": {
      "required": [
        "type",
        "data.data_type",
        "data.data"
      ],
      "optional": [
        "node",
        "data.message",
        "data.tool_name",
        "data.tool_call_id"
      ],
      "constraints": {
        "type": {
          "enum": [
            "result"
          ]
        },
        "data.data_type": {
          "type": "string",
          "min_length": 1
        }
      }
    },
    "interrupt": {
      "required": [
        "type",
        "data.thread_id",
        "data.interrupt_id",
        "data.value"
      ],
      "optional": [
        "node",
        "data.value.message",
        "data.value.action_requests",
        "data.value.review_configs",
        "data.tool_call_id"
      ],
      "constraints": {
        "type": {
          "enum": [
            "interrupt"
          ]
        },
        "data.interrupt_id": {
          "type": "string",
          "min_length": 1
        }
      }
    }
  }
}
