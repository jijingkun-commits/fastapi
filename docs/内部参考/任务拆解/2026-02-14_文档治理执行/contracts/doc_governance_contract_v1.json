{
  "contract_type": "docs_governance",
  "version": "v1",
  "task_key": "PP-20260214-DOCS-GOVERNANCE",
  "frozen_at": "2026-02-14",
  "rules": {
    "authority_rule": {
      "required": [
        "scope",
        "authority_source",
        "consumer_scope"
      ],
      "optional": [
        "notes"
      ],
      "items": [
        {
          "scope": "commands_detail",
          "authority_source": ".cursor/commands/*.md",
          "consumer_scope": [
            "docs/开发文档/技巧与速查/",
            "docs/开发文档/工作流/"
          ],
          "notes": "速查类文档保留索引，不复制命令细节定义"
        },
        {
          "scope": "architecture_decision",
          "authority_source": "docs/开发文档/架构设计/",
          "consumer_scope": [
            "docs/开发文档/代码解读/"
          ],
          "notes": "代码解读仅做实现走读，不重定义架构决策"
        }
      ]
    },
    "naming_rule": {
      "required": [
        "directory",
        "pattern",
        "keep_structure"
      ],
      "optional": [
        "examples"
      ],
      "items": [
        {
          "directory": "docs/内部参考/迭代需求/",
          "pattern": "通用入口 + 专项前缀（如 *_requirements.md, *_plan.md）",
          "keep_structure": true,
          "examples": [
            "requirements.md",
            "implementation_plan.md",
            "skill_admin_frontend_requirements.md",
            "docs_governance_requirements.md"
          ]
        }
      ]
    },
    "placeholder_rule": {
      "required": [
        "marker",
        "applies_to"
      ],
      "optional": [
        "replacement_hint"
      ],
      "items": [
        {
          "marker": "示例占位",
          "applies_to": [
            "docs/开发文档/工作流/开发工作流.md"
          ],
          "replacement_hint": "示例路径需由实际业务路径替换后再落地"
        }
      ]
    }
  },
  "compatibility": {
    "additive_only": true,
    "forbidden": [
      "rewrite_existing_scope_semantics",
      "remove_placeholder_marker",
      "enforce_new_archive_structure"
    ]
  }
}
