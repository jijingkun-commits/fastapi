# 统一的 .gitignore（Python FastAPI 后端 + Next.js 前端）

#参照类代码
demo/

# 操作系统与编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/

# IDE/Agent 配置目录
.agent/
.claude/
.cursor/
.codex_plugins/
.omc/
.omx/
.playwright-cli/
.trae/
.cline/
.clinerules/
.kilocodemodes
.kilocoderules

# 允许 AI 会话通过 @ 引用规则/命令/技能文档（其他文件仍忽略）
!AGENTS.md
!**/AGENTS.md

!.cursor/
.cursor/*

!.cursor/commands/
.cursor/commands/*
!.cursor/commands/*.md

!.cursor/rules/
.cursor/rules/*
!.cursor/rules/*.mdc

!.cursor/skills/
.cursor/skills/*
!.cursor/skills/*/
!.cursor/skills/*/SKILL.md
!.cursor/skills/*/.skill-meta.json

# Cursor 本地运行态文件（不纳入版本控制）
.cursor/debug.log
.cursor/worktrees.json

.agent/*

# 通用日志与构建输出
*.log
logs/
.vibe/
dist/
build/
coverage/

# E2E 测试调试截图
web/e2e/debug-step-*.png
.coverage
coverage.xml
htmlcov/
test-results/
web/test-results/
web/playwright-report/

# 数据库
*.db
*.sqlite
*.sqlite3
dev.db

# 敏感信息
.env
.env.*
!.env.example
web/.auth/

# Python（FastAPI 后端）
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
*.egg
.cache/
.mypy_cache/
.pytest_cache/
.tox/
.ruff_cache/
.venv/
venv/
uvicorn.out

# Node/Next.js（前端 web/）
web/node_modules/
web/.next/
web/.vercel/
web/.turbo/
pnpm-debug.log*
npm-debug.log*
yarn-error.log*

# 数据目录（大文件不纳入版本控制，仅限项目根目录）
/data/
!/data/README.md

# 运行态目录（不纳入版本控制）
/.state/
/output/
/workdocs/stash-archive/

# 其他（按需扩展）
*.swp
*.swo
*.tmp
*.bak
ragflow/
