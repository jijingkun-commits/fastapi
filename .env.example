# === 数据库配置 ===
# 系统数据库（聊天、用户、待办等）
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/chat_db

# 问数分析库（只读连接，生产环境应与系统库隔离）
ANALYTICS_DATABASE_URL=postgresql+psycopg://readonly:password@localhost:5432/data_db

# 问数允许的 Schema 白名单（逗号分隔）
ANALYTICS_SCHEMAS=fdmdata,sdmdata,public

# 默认 Schema（无法识别时使用）
ANALYTICS_DEFAULT_SCHEMA=fdmdata

# Schema 别名映射（用户友好名称:实际schema，逗号分隔）
SCHEMA_ALIASES=存款:fdmdata,贷款:fdmdata,维度:sdmdata,日期:sdmdata

# LangGraph 检查点存储（使用与主库相同的数据库）
PG_CHECKPOINTER_URI=postgres://postgres:postgres@localhost:5432/chat_db

# === JWT 配置 ===
# 生产环境要求：JWT_SECRET 必须至少 32 字符，禁止使用弱密钥
# 可使用 openssl rand -base64 32 生成强密钥
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
# 仅开发模式：启动时插入admin用户（用户名：admin，密码：secret）
INIT_DB_ON_STARTUP=false

# === LLM API 配置 ===
# 阿里云 DashScope API Key（对话模型：DeepSeek-V3.1/Qwen 系列）
# 获取地址：https://dashscope.console.aliyun.com/
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 智谱 AI API Key（Embedding 模型）
# 获取地址：https://open.bigmodel.cn/
ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxx

# Tavily 联网搜索 API Key（可选，不配置则联网搜索不可用）
# 获取地址：https://app.tavily.com/sign-in
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Embedding 向量配置 ===
# 重要：数据库 Vector 列定义为 2048 维，必须使用 embedding-3 模型
# 智谱 embedding-3: 2048 维 ✅ 推荐
# 智谱 embedding-2: 1024 维 ❌ 不兼容
EMBEDDING_DIMENSION=2048

# === 功能开关 ===
# LLM Judge 输出质量评估（问数助手 SQL 质量检查）
ENABLE_LLM_JUDGE=false

# 结果增强规则开关（关闭后直接返回原始 SQL 结果）
ENABLE_RESULT_ENRICHMENT=true

# 结果增强规则缓存 TTL（秒）
RESULT_ENRICHMENT_RULE_TTL_SECONDS=120

# 新用户偏好记忆初始化模板（JSON，受控记忆项白名单）
# 默认将 AI 人设初始化为“小嘉”，可按需改为其他名称
USER_PREFERENCE_MEMORY_BOOTSTRAP_TEMPLATE={"assistant.persona":"小嘉"}

# 用户个性化永久记忆（纯文档 + 单开关）
# true: 启用文档化记忆全链路（写入/召回/管理）
# false: 关闭文档化记忆链路
ENABLE_DOCUMENT_MEMORY=false
# 聊天主链路记忆模式开关
# true: 主链路仅入队 t_user_memory_intent_job（异步判定）
# false: 回退历史同步写入链路
MEMORY_INTENT_ASYNC_ENABLED=false
# 文档记忆召回片段上限
DOCUMENT_MEMORY_MAX_RESULTS=6
# 文档记忆注入上下文预算（字符）
DOCUMENT_MEMORY_MAX_INJECTED_CHARS=1200
# 文档记忆混合检索权重（建议两者和为 1.0）
DOCUMENT_MEMORY_VECTOR_WEIGHT=0.7
DOCUMENT_MEMORY_TEXT_WEIGHT=0.3
# 文档记忆混合召回最低分阈值
DOCUMENT_MEMORY_HYBRID_MIN_SCORE=0.05
# 文档记忆向量补偿每批处理数量
DOCUMENT_MEMORY_EMBEDDING_BATCH_SIZE=32
# 文档记忆向量自动重试上限
DOCUMENT_MEMORY_EMBEDDING_MAX_RETRY=3

# 运行态控制开关（run 生命周期 + 取消语义）
# true: 启用 run 控制，支持 /api/v1/chat/runs/{run_id}/cancel
# false: 回退兼容路径（仅内存级执行，不记录 run 生命周期）
ENABLE_RUN_CONTROL=false
# true: cancel 时额外发送 stopped 事件（done(meta.status=stopped) 仍保留）
# false: 不发送 stopped，仅通过 done 元数据表达终态
ENABLE_SSE_STOPPED_EVENT=false

# Skill 多用户版本治理开关（P3）
# true: 启用 Skill 版本发布/回滚能力（definition/version/binding 三层）
# false: 回退到兼容路径，仅使用 t_agent_skills
ENABLE_SKILL_VERSIONING=false
# true: 启用用户级 Skill 绑定覆盖（按 user_id 生效）
# false: 忽略用户绑定，统一使用平台发布版本
ENABLE_USER_SKILL_BINDING=false

# 工具治理开关（运行时策略过滤）
# true: 按 tool_governance.* 配置过滤工具列表
# false: 使用默认工具集合
ENABLE_TOOL_GOVERNANCE=false
# compat/allow/deny/minimal
TOOL_POLICY_FAIL_MODE=compat

# 中转供应商实验适配（仅开发/测试环境）
# 生产环境固定不生效（ENV=prod 时强制关闭）
# 注意：该参数仅在数据库未配置 feature.proxy_experiment_enabled 时作为兜底
ENABLE_PROXY_EXPERIMENT=false
# 注意：该参数仅在数据库未配置 feature.proxy_experiment_providers 时作为兜底
PROXY_EXPERIMENT_PROVIDERS=openai_proxy_trial

# internal 调用输入清洗开关（非 prod 默认 true，prod 默认 false）
ENABLE_INTERNAL_CONTENT_SANITIZE=true

# 规则与命令体系发布开关（C-5 灰度与回滚）
# true: 启用 V2 行为（规则集/命令注册中心）
# false: 回退 V1 兼容路径
ENABLE_RULESET_V2=false
ENABLE_PROMPT_REGISTRY_V2=false
# 灰度比例（0-100，建议按 10 -> 30 -> 100 推进）
RULESET_V2_ROLLOUT_PERCENTAGE=0
PROMPT_REGISTRY_V2_ROLLOUT_PERCENTAGE=0

# 模型路由回退默认值（运行时优先从 t_system_config 表读取，此处仅作为回退值）
LLM_JUDGE_MODEL=qwen-plus
INTENT_CLASSIFIER_MODEL=qwen-plus
SQL_GENERATION_MODEL=qwen-plus

# === 可观测性 (Observability) ===
# 启用可观测性追踪 (true/false)
ENABLE_OBSERVABILITY=false

# Langfuse 配置 (可选，需要先注册 https://langfuse.com)
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# === Vibe Kanban 多 worktree 本机开发（可选） ===
# 主分支识别列表（命中后固定 8000/3000）
VK_MAIN_BRANCHES=main,master
# 主分支固定端口
VK_MAIN_BACKEND_PORT=8000
VK_MAIN_FRONTEND_PORT=3000
# 手工覆盖当前 worktree 端口（为空则自动计算）
# VK_BACKEND_PORT=8101
# VK_FRONTEND_PORT=3101
# 共享 Python 虚拟环境策略：auto(默认)/always/off
# - auto: 本地 venv 不可用时，通过 .vibe/venv 指向主 worktree 的 venv
# - always: 强制要求共享 venv 可用，不可用则失败
# - off: 禁用共享 venv 自动链接
# VK_SHARED_VENV_MODE=auto
# 指定共享 venv 绝对路径（为空时自动回退主 worktree/venv）
# VK_SHARED_VENV_PATH=/Users/yourname/fastapi/venv
# 测试脚本端口（默认跟随当前后端/前端端口）
# TEST_BACKEND_PORT=8000
# TEST_FRONTEND_PORT=3000
# 在线 API / E2E 基础地址（默认 http://127.0.0.1:${TEST_BACKEND_PORT}）
# E2E_API_BASE=http://127.0.0.1:8000
# LIVE_API_BASE=http://127.0.0.1:8000/api/v1
# Playwright 前端地址（默认 http://127.0.0.1:${TEST_FRONTEND_PORT}）
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_FRONTEND_PORT=3000
# Playwright 浏览器通道（默认本地 chrome；CI 建议留空使用 bundled chromium）
# PLAYWRIGHT_BROWSER_CHANNEL=chrome
