+"""API Key 数据模型。"""
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Optional
+
+from sqlalchemy import Boolean, DateTime, ForeignKey, Integer, String
+from sqlalchemy.orm import Mapped, mapped_column
+
+from app.db.base import Base
+
+
+class APIKey(Base):
+    """API Key 主表。"""
+
+    __tablename__ = "t_api_key"
+
+    id: Mapped[int] = mapped_column(Integer, primary_key=True, index=True)
+
+    # 关联用户（必填）
+    user_id: Mapped[int] = mapped_column(
+        Integer, ForeignKey("t_user.id"), nullable=False, index=True, comment="关联用户ID"
+    )
+
+    # API Key（sk- 前缀 + 32 字节随机字符串）
+    key: Mapped[str] = mapped_column(
+        String(64), unique=True, index=True, nullable=False, comment="API Key"
+    )
+
+    # 密钥名称（便于管理员识别）
+    name: Mapped[str] = mapped_column(String(100), nullable=False, comment="密钥名称")
+
+    # 权限范围（逗号分隔，如 "exam:admin,chat:read"）
+    scopes: Mapped[str] = mapped_column(String(500), nullable=False, comment="权限范围")
+
+    # 速率限制（每分钟最大请求数）
+    rate_limit_per_minute: Mapped[int] = mapped_column(
+        Integer, default=60, nullable=False, comment="速率限制（每分钟）"
+    )
+
+    # 使用统计
+    usage_count: Mapped[int] = mapped_column(Integer, default=0, nullable=False, comment="使用次数")
+    last_used_at: Mapped[Optional[datetime]] = mapped_column(DateTime, comment="最后使用时间")
+
+    # 状态与过期
+    is_active: Mapped[bool] = mapped_column(Boolean, default=True, nullable=False, comment="是否激活")
+    expires_at: Mapped[Optional[datetime]] = mapped_column(DateTime, comment="过期时间（可选）")
+
+    # 审计字段
+    created_at: Mapped[datetime] = mapped_column(
+        DateTime, default=datetime.now, nullable=False, comment="创建时间"
+    )
+    created_by: Mapped[int] = mapped_column(
+        Integer, ForeignKey("t_user.id"), nullable=False, comment="创建者ID"
+    )
+    revoked_at: Mapped[Optional[datetime]] = mapped_column(DateTime, comment="撤销时间")
+    revoked_by: Mapped[Optional[int]] = mapped_column(
+        Integer, ForeignKey("t_user.id"), comment="撤销者ID"
+    )
+
+    def __repr__(self) -> str:
+        return f"<APIKey(id={self.id}, name={self.name}, user_id={self.user_id}, is_active={self.is_active})>"
+
+
+class APIKeyAuditLog(Base):
+    """API Key 审计日志表。"""
+
+    __tablename__ = "t_api_key_audit_log"
+
+    id: Mapped[int] = mapped_column(Integer, primary_key=True, index=True)
+    api_key_id: Mapped[int] = mapped_column(
+        Integer, ForeignKey("t_api_key.id"), nullable=False, index=True, comment="API Key ID"
+    )
+    user_id: Mapped[int] = mapped_column(
+        Integer, ForeignKey("t_user.id"), nullable=False, index=True, comment="用户ID"
+    )
+
+    # 请求信息
+    request_url: Mapped[str] = mapped_column(String(500), nullable=False, comment="请求URL")
+    request_method: Mapped[str] = mapped_column(String(10), nullable=False, comment="请求方法")
+    response_status: Mapped[int] = mapped_column(Integer, nullable=False, comment="响应状态码")
+
+    # 时间戳
+    created_at: Mapped[datetime] = mapped_column(
+        DateTime, default=datetime.now, nullable=False, index=True, comment="创建时间"
+    )
+
+    def __repr__(self) -> str:
+        return f"<APIKeyAuditLog(id={self.id}, api_key_id={self.api_key_id}, request_url={self.request_url})>"
