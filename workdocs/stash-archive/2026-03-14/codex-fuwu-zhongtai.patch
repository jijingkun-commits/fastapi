+"""API Key 管理接口（管理员专用）。"""
+from typing import Optional
+
+from fastapi import APIRouter, Depends, HTTPException, status
+from sqlalchemy.orm import Session
+
+from app.api.deps import get_admin_user
+from app.db.session import get_db
+from app.models.user import User
+from app.schemas.api_key import (
+    APIKeyCreateRequest,
+    APIKeyListResponse,
+    APIKeyResponse,
+    APIKeyStatsResponse,
+)
+from app.services import api_key_service
+from app.services import audit_log_service
+
+router = APIRouter()
+
+
+@router.post("/api-keys", response_model=APIKeyResponse, status_code=status.HTTP_201_CREATED)
+async def create_api_key(
+    request: APIKeyCreateRequest,
+    db: Session = Depends(get_db),
+    current_user: User = Depends(get_admin_user),
+):
+    """创建新的 API Key（管理员专用）。
+
+    Args:
+        request: 创建请求
+        db: 数据库会话
+        current_user: 当前管理员用户
+
+    Returns:
+        创建的 API Key（包含完整 key，仅此一次返回）
+    """
+    # 创建 API Key
+    api_key = api_key_service.create_api_key(
+        db=db,
+        request=request,
+        created_by=current_user.id,
+    )
+
+    return api_key
+
+
+@router.get("/api-keys", response_model=APIKeyListResponse)
+async def list_api_keys(
+    user_id: Optional[int] = None,
+    is_active: Optional[bool] = None,
+    limit: int = 50,
+    offset: int = 0,
+    db: Session = Depends(get_db),
+    current_user: User = Depends(get_admin_user),
+):
+    """查询 API Key 列表（管理员专用）。
+
+    Args:
+        user_id: 用户ID（可选，None 表示查询所有）
+        is_active: 是否激活（可选，None 表示不过滤）
+        limit: 返回数量限制
+        offset: 偏移量
+        db: 数据库会话
+        current_user: 当前管理员用户
+
+    Returns:
+        API Key 列表
+    """
+    return api_key_service.list_api_keys(
+        db=db,
+        user_id=user_id,
+        is_active=is_active,
+        limit=limit,
+        offset=offset,
+    )
+
+
+@router.get("/api-keys/{key_id}", response_model=APIKeyResponse)
+async def get_api_key(
+    key_id: int,
+    db: Session = Depends(get_db),
+    current_user: User = Depends(get_admin_user),
+):
+    """查询单个 API Key 详情（管理员专用）。
+
+    Args:
+        key_id: API Key ID
+        db: 数据库会话
+        current_user: 当前管理员用户
+
+    Returns:
+        API Key 详情
+    """
+    api_key = api_key_service.get_api_key_by_id(db=db, api_key_id=key_id)
+    if not api_key:
+        raise HTTPException(
+            status_code=status.HTTP_404_NOT_FOUND,
+            detail="API Key 不存在",
+        )
+
+    return api_key
+
+
+@router.delete("/api-keys/{key_id}", response_model=APIKeyResponse)
+async def revoke_api_key(
+    key_id: int,
+    db: Session = Depends(get_db),
+    current_user: User = Depends(get_admin_user),
+):
+    """撤销 API Key（管理员专用）。
+
+    Args:
+        key_id: API Key ID
+        db: 数据库会话
+        current_user: 当前管理员用户
+
+    Returns:
+        撤销后的 API Key
+    """
+    api_key = api_key_service.revoke_api_key(
+        db=db,
+        api_key_id=key_id,
+        revoked_by=current_user.id,
+    )
+    if not api_key:
+        raise HTTPException(
+            status_code=status.HTTP_404_NOT_FOUND,
+            detail="API Key 不存在",
+        )
+
+    return api_key
+
+
+@router.get("/api-keys/{key_id}/stats", response_model=APIKeyStatsResponse)
+async def get_api_key_stats(
+    key_id: int,
+    db: Session = Depends(get_db),
+    current_user: User = Depends(get_admin_user),
+):
+    """查询 API Key 使用统计（管理员专用）。
+
+    Args:
+        key_id: API Key ID
+        db: 数据库会话
+        current_user: 当前管理员用户
+
+    Returns:
+        使用统计
+    """
+    # 先检查 API Key 是否存在
+    api_key = api_key_service.get_api_key_by_id(db=db, api_key_id=key_id)
+    if not api_key:
+        raise HTTPException(
+            status_code=status.HTTP_404_NOT_FOUND,
+            detail="API Key 不存在",
+        )
+
+    # 查询使用统计
+    return api_key_service.get_usage_stats(db=db, api_key_id=key_id)
+
+
+@router.get("/api-keys/{key_id}/logs")
+async def get_api_key_logs(
+    key_id: int,
+    limit: int = 100,
+    db: Session = Depends(get_db),
+    current_user: User = Depends(get_admin_user),
+):
+    """查询 API Key 最近的审计日志（管理员专用）。
+
+    Args:
+        key_id: API Key ID
+        limit: 返回数量限制
+        db: 数据库会话
+        current_user: 当前管理员用户
+
+    Returns:
+        审计日志列表
+    """
+    # 先检查 API Key 是否存在
+    api_key = api_key_service.get_api_key_by_id(db=db, api_key_id=key_id)
+    if not api_key:
+        raise HTTPException(
+            status_code=status.HTTP_404_NOT_FOUND,
+            detail="API Key 不存在",
+        )
+
+    # 查询审计日志
+    logs = audit_log_service.get_recent_logs(db=db, api_key_id=key_id, limit=limit)
+
+    # 转换为字典列表
+    return [
+        {
+            "id": log.id,
+            "api_key_id": log.api_key_id,
+            "user_id": log.user_id,
+            "request_url": log.request_url,
+            "request_method": log.request_method,
+            "response_status": log.response_status,
+            "created_at": log.created_at,
+        }
+        for log in logs
+    ]
