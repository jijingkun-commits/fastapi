+"""API Key 数据访问层。"""
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Optional
+
+from sqlalchemy import and_, or_
+from sqlalchemy.orm import Session
+
+from app.models.api_key import APIKey
+
+
+def create_api_key(
+    db: Session,
+    user_id: int,
+    key: str,
+    name: str,
+    scopes: str,
+    rate_limit_per_minute: int,
+    created_by: int,
+    expires_at: Optional[datetime] = None,
+) -> APIKey:
+    """创建新的 API Key。
+
+    Args:
+        db: 数据库会话
+        user_id: 关联用户ID
+        key: API Key
+        name: 密钥名称
+        scopes: 权限范围（逗号分隔）
+        rate_limit_per_minute: 速率限制
+        created_by: 创建者ID
+        expires_at: 过期时间（可选）
+
+    Returns:
+        创建的 API Key 对象
+    """
+    api_key = APIKey(
+        user_id=user_id,
+        key=key,
+        name=name,
+        scopes=scopes,
+        rate_limit_per_minute=rate_limit_per_minute,
+        created_by=created_by,
+        expires_at=expires_at,
+        usage_count=0,
+        is_active=True,
+        created_at=datetime.now(),
+    )
+    db.add(api_key)
+    db.commit()
+    db.refresh(api_key)
+    return api_key
+
+
+def get_by_key(db: Session, key: str) -> Optional[APIKey]:
+    """根据 key 查询 API Key。
+
+    Args:
+        db: 数据库会话
+        key: API Key
+
+    Returns:
+        API Key 对象，如果不存在则返回 None
+    """
+    return db.query(APIKey).filter(APIKey.key == key).first()
+
+
+def get_by_id(db: Session, api_key_id: int) -> Optional[APIKey]:
+    """根据 ID 查询 API Key。
+
+    Args:
+        db: 数据库会话
+        api_key_id: API Key ID
+
+    Returns:
+        API Key 对象，如果不存在则返回 None
+    """
+    return db.query(APIKey).filter(APIKey.id == api_key_id).first()
+
+
+def get_by_user_id(
+    db: Session,
+    user_id: int,
+    is_active: Optional[bool] = None,
+    limit: int = 50,
+    offset: int = 0,
+) -> list[APIKey]:
+    """根据 user_id 查询 API Key 列表。
+
+    Args:
+        db: 数据库会话
+        user_id: 用户ID
+        is_active: 是否激活（可选，None 表示不过滤）
+        limit: 返回数量限制
+        offset: 偏移量
+
+    Returns:
+        API Key 列表
+    """
+    query = db.query(APIKey).filter(APIKey.user_id == user_id)
+
+    if is_active is not None:
+        query = query.filter(APIKey.is_active == is_active)
+
+    return query.order_by(APIKey.created_at.desc()).limit(limit).offset(offset).all()
+
+
+def list_all(
+    db: Session,
+    is_active: Optional[bool] = None,
+    limit: int = 50,
+    offset: int = 0,
+) -> list[APIKey]:
+    """查询所有 API Key 列表（管理员用）。
+
+    Args:
+        db: 数据库会话
+        is_active: 是否激活（可选，None 表示不过滤）
+        limit: 返回数量限制
+        offset: 偏移量
+
+    Returns:
+        API Key 列表
+    """
+    query = db.query(APIKey)
+
+    if is_active is not None:
+        query = query.filter(APIKey.is_active == is_active)
+
+    return query.order_by(APIKey.created_at.desc()).limit(limit).offset(offset).all()
+
+
+def count_by_user_id(db: Session, user_id: int, is_active: Optional[bool] = None) -> int:
+    """统计用户的 API Key 数量。
+
+    Args:
+        db: 数据库会话
+        user_id: 用户ID
+        is_active: 是否激活（可选，None 表示不过滤）
+
+    Returns:
+        API Key 数量
+    """
+    query = db.query(APIKey).filter(APIKey.user_id == user_id)
+
+    if is_active is not None:
+        query = query.filter(APIKey.is_active == is_active)
+
+    return query.count()
+
+
+def revoke_api_key(db: Session, api_key_id: int, revoked_by: int) -> Optional[APIKey]:
+    """撤销 API Key。
+
+    Args:
+        db: 数据库会话
+        api_key_id: API Key ID
+        revoked_by: 撤销者ID
+
+    Returns:
+        撤销后的 API Key 对象，如果不存在则返回 None
+    """
+    api_key = db.query(APIKey).filter(APIKey.id == api_key_id).first()
+    if not api_key:
+        return None
+
+    api_key.is_active = False
+    api_key.revoked_at = datetime.now()
+    api_key.revoked_by = revoked_by
+
+    db.commit()
+    db.refresh(api_key)
+    return api_key
+
+
+def update_last_used(db: Session, api_key_id: int) -> None:
+    """更新最后使用时间和使用次数。
+
+    Args:
+        db: 数据库会话
+        api_key_id: API Key ID
+    """
+    api_key = db.query(APIKey).filter(APIKey.id == api_key_id).first()
+    if api_key:
+        api_key.last_used_at = datetime.now()
+        api_key.usage_count += 1
+        db.commit()
