+"""API Key 相关的 Pydantic Schema。"""
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Optional
+
+from pydantic import BaseModel, Field, field_validator
+
+
+class APIKeyCreateRequest(BaseModel):
+    """创建 API Key 的请求体。"""
+
+    name: str = Field(..., min_length=1, max_length=100, description="密钥名称")
+    user_id: int = Field(..., gt=0, description="关联用户ID")
+    scopes: list[str] = Field(..., min_length=1, description="权限范围列表")
+    rate_limit_per_minute: int = Field(default=60, gt=0, le=1000, description="速率限制（每分钟）")
+    expires_at: Optional[datetime] = Field(default=None, description="过期时间（可选）")
+
+    @field_validator("scopes")
+    @classmethod
+    def validate_scopes(cls, v: list[str]) -> list[str]:
+        """验证权限范围非空。"""
+        if not v:
+            raise ValueError("权限范围不能为空")
+        # 去重
+        return list(set(v))
+
+
+class APIKeyResponse(BaseModel):
+    """API Key 详情响应。"""
+
+    id: int
+    user_id: int
+    key: str  # 只在创建时返回完整 key，查询时只返回前 8 位
+    name: str
+    scopes: list[str]
+    rate_limit_per_minute: int
+    usage_count: int
+    last_used_at: Optional[datetime]
+    is_active: bool
+    expires_at: Optional[datetime]
+    created_at: datetime
+    created_by: int
+    revoked_at: Optional[datetime]
+    revoked_by: Optional[int]
+
+    model_config = {"from_attributes": True}
+
+    @classmethod
+    def from_orm_with_masked_key(cls, obj: any, mask_key: bool = True) -> "APIKeyResponse":
+        """从 ORM 对象创建响应，可选择是否遮蔽 key。"""
+        data = {
+            "id": obj.id,
+            "user_id": obj.user_id,
+            "key": obj.key[:8] + "..." if mask_key else obj.key,
+            "name": obj.name,
+            "scopes": obj.scopes.split(",") if obj.scopes else [],
+            "rate_limit_per_minute": obj.rate_limit_per_minute,
+            "usage_count": obj.usage_count,
+            "last_used_at": obj.last_used_at,
+            "is_active": obj.is_active,
+            "expires_at": obj.expires_at,
+            "created_at": obj.created_at,
+            "created_by": obj.created_by,
+            "revoked_at": obj.revoked_at,
+            "revoked_by": obj.revoked_by,
+        }
+        return cls(**data)
+
+
+class APIKeyListResponse(BaseModel):
+    """API Key 列表响应。"""
+
+    items: list[APIKeyResponse]
+    total: int
+
+
+class APIKeyStatsResponse(BaseModel):
+    """API Key 使用统计响应。"""
+
+    api_key_id: int
+    total_requests: int
+    success_count: int
+    error_count: int
+    avg_requests_per_day: float
+    last_used_at: Optional[datetime]
