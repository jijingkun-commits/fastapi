+"""速率限制服务。
+
+基于 Redis 实现滑动窗口限流，降级到内存计数器（单机模式）。
+"""
+from __future__ import annotations
+
+import time
+from collections import defaultdict
+from typing import Optional
+
+from app.core.config import REDIS_URL
+
+
+class RateLimiter:
+    """速率限制器。
+
+    优先使用 Redis，如果不可用则降级到内存计数器。
+    """
+
+    def __init__(self):
+        """初始化速率限制器。"""
+        self.redis_client: Optional[any] = None
+        self.memory_store: dict[str, list[float]] = defaultdict(list)
+
+        # 尝试连接 Redis
+        if REDIS_URL:
+            try:
+                import redis
+
+                self.redis_client = redis.from_url(REDIS_URL, decode_responses=True)
+                # 测试连接
+                self.redis_client.ping()
+                print("✅ 速率限制器使用 Redis")
+            except Exception as e:
+                print(f"⚠️ Redis 连接失败，降级到内存计数器: {e}")
+                self.redis_client = None
+        else:
+            print("⚠️ 未配置 REDIS_URL，使用内存计数器")
+
+    def check_rate_limit(self, api_key_id: int, limit_per_minute: int) -> bool:
+        """检查是否超过速率限制。
+
+        Args:
+            api_key_id: API Key ID
+            limit_per_minute: 每分钟最大请求数
+
+        Returns:
+            True 表示未超限，False 表示超限
+        """
+        if self.redis_client:
+            return self._check_rate_limit_redis(api_key_id, limit_per_minute)
+        else:
+            return self._check_rate_limit_memory(api_key_id, limit_per_minute)
+
+    def _check_rate_limit_redis(self, api_key_id: int, limit_per_minute: int) -> bool:
+        """基于 Redis 的速率限制检查（滑动窗口）。
+
+        Args:
+            api_key_id: API Key ID
+            limit_per_minute: 每分钟最大请求数
+
+        Returns:
+            True 表示未超限，False 表示超限
+        """
+        key = f"rate_limit:api_key:{api_key_id}"
+        now = time.time()
+        window_start = now - 60  # 60 秒窗口
+
+        try:
+            # 使用 Redis Sorted Set 实现滑动窗口
+            pipe = self.redis_client.pipeline()
+
+            # 删除窗口外的记录
+            pipe.zremrangebyscore(key, 0, window_start)
+
+            # 获取当前窗口内的请求数
+            pipe.zcard(key)
+
+            # 添加当前请求
+            pipe.zadd(key, {str(now): now})
+
+            # 设置过期时间（61 秒，略大于窗口）
+            pipe.expire(key, 61)
+
+            results = pipe.execute()
+            current_count = results[1]
+
+            # 判断是否超限
+            return current_count < limit_per_minute
+
+        except Exception as e:
+            print(f"⚠️ Redis 速率限制检查失败，降级到内存: {e}")
+            return self._check_rate_limit_memory(api_key_id, limit_per_minute)
+
+    def _check_rate_limit_memory(self, api_key_id: int, limit_per_minute: int) -> bool:
+        """基于内存的速率限制检查（滑动窗口）。
+
+        Args:
+            api_key_id: API Key ID
+            limit_per_minute: 每分钟最大请求数
+
+        Returns:
+            True 表示未超限，False 表示超限
+        """
+        key = f"api_key:{api_key_id}"
+        now = time.time()
+        window_start = now - 60  # 60 秒窗口
+
+        # 清理窗口外的记录
+        self.memory_store[key] = [ts for ts in self.memory_store[key] if ts > window_start]
+
+        # 检查是否超限
+        if len(self.memory_store[key]) >= limit_per_minute:
+            return False
+
+        # 添加当前请求
+        self.memory_store[key].append(now)
+        return True
+
+
+# 全局单例
+_rate_limiter: Optional[RateLimiter] = None
+
+
+def get_rate_limiter() -> RateLimiter:
+    """获取速率限制器单例。
+
+    Returns:
+        速率限制器实例
+    """
+    global _rate_limiter
+    if _rate_limiter is None:
+        _rate_limiter = RateLimiter()
+    return _rate_limiter
+
+
+def check_rate_limit(api_key_id: int, limit_per_minute: int) -> bool:
+    """检查是否超过速率限制（便捷函数）。
+
+    Args:
+        api_key_id: API Key ID
+        limit_per_minute: 每分钟最大请求数
+
+    Returns:
+        True 表示未超限，False 表示超限
+    """
+    limiter = get_rate_limiter()
+    return limiter.check_rate_limit(api_key_id, limit_per_minute)
