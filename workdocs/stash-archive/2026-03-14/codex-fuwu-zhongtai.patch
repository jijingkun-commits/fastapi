+/**
+ * API Key 管理面板组件
+ */
+'use client'
+
+import { useState, useEffect } from 'react'
+import {
+  createAPIKey,
+  listAPIKeys,
+  revokeAPIKey,
+  getAPIKeyStats,
+  type APIKeyResponse,
+  type APIKeyCreateRequest,
+  type APIKeyStatsResponse,
+} from '@/lib/api-key-admin-api'
+
+export default function APIKeyPanel() {
+  const [apiKeys, setApiKeys] = useState<APIKeyResponse[]>([])
+  const [loading, setLoading] = useState(true)
+  const [error, setError] = useState<string | null>(null)
+  const [showCreateForm, setShowCreateForm] = useState(false)
+  const [selectedKey, setSelectedKey] = useState<APIKeyResponse | null>(null)
+  const [stats, setStats] = useState<APIKeyStatsResponse | null>(null)
+
+  // 表单状态
+  const [formData, setFormData] = useState<APIKeyCreateRequest>({
+    name: '',
+    user_id: 21, // 默认使用 api_system 用户
+    scopes: ['exam:admin'],
+    rate_limit_per_minute: 60,
+  })
+
+  // 新创建的 API Key（完整 key，仅显示一次）
+  const [newApiKey, setNewApiKey] = useState<string | null>(null)
+
+  // 加载 API Key 列表
+  const loadAPIKeys = async () => {
+    try {
+      setLoading(true)
+      setError(null)
+      const response = await listAPIKeys()
+      setApiKeys(response.items)
+    } catch (err) {
+      setError(err instanceof Error ? err.message : '加载失败')
+    } finally {
+      setLoading(false)
+    }
+  }
+
+  useEffect(() => {
+    loadAPIKeys()
+  }, [])
+
+  // 创建 API Key
+  const handleCreate = async (e: React.FormEvent) => {
+    e.preventDefault()
+    try {
+      setError(null)
+      const result = await createAPIKey(formData)
+      setNewApiKey(result.key) // 保存完整 key
+      setShowCreateForm(false)
+      setFormData({
+        name: '',
+        user_id: 21,
+        scopes: ['exam:admin'],
+        rate_limit_per_minute: 60,
+      })
+      await loadAPIKeys()
+    } catch (err) {
+      setError(err instanceof Error ? err.message : '创建失败')
+    }
+  }
+
+  // 撤销 API Key
+  const handleRevoke = async (keyId: number) => {
+    if (!confirm('确定要撤销此 API Key 吗？撤销后无法恢复。')) {
+      return
+    }
+
+    try {
+      setError(null)
+      await revokeAPIKey(keyId)
+      await loadAPIKeys()
+    } catch (err) {
+      setError(err instanceof Error ? err.message : '撤销失败')
+    }
+  }
+
+  // 查看统计
+  const handleViewStats = async (key: APIKeyResponse) => {
+    try {
+      setError(null)
+      const statsData = await getAPIKeyStats(key.id)
+      setStats(statsData)
+      setSelectedKey(key)
+    } catch (err) {
+      setError(err instanceof Error ? err.message : '查询统计失败')
+    }
+  }
+
+  // 复制到剪贴板
+  const copyToClipboard = (text: string) => {
+    navigator.clipboard.writeText(text)
+    alert('已复制到剪贴板')
+  }
+
+  if (loading) {
+    return <div className="p-4">加载中...</div>
+  }
+
+  return (
+    <div className="p-6 max-w-7xl mx-auto">
+      <div className="flex justify-between items-center mb-6">
+        <h1 className="text-2xl font-bold">API Key 管理</h1>
+        <button
+          onClick={() => setShowCreateForm(true)}
+          className="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700"
+        >
+          创建 API Key
+        </button>
+      </div>
+
+      {error && (
+        <div className="mb-4 p-4 bg-red-50 border border-red-200 rounded text-red-700">
+          {error}
+        </div>
+      )}
+
+      {/* 新创建的 API Key 提示（仅显示一次） */}
+      {newApiKey && (
+        <div className="mb-4 p-4 bg-green-50 border border-green-200 rounded">
+          <p className="font-bold text-green-800 mb-2">API Key 创建成功！</p>
+          <p className="text-sm text-green-700 mb-2">
+            请立即复制并保存此 API Key，关闭后将无法再次查看完整密钥。
+          </p>
+          <div className="flex items-center gap-2">
+            <code className="flex-1 p-2 bg-white border rounded font-mono text-sm">
+              {newApiKey}
+            </code>
+            <button
+              onClick={() => copyToClipboard(newApiKey)}
+              className="px-3 py-2 bg-green-600 text-white rounded hover:bg-green-700"
+            >
+              复制
+            </button>
+            <button
+              onClick={() => setNewApiKey(null)}
+              className="px-3 py-2 bg-gray-600 text-white rounded hover:bg-gray-700"
+            >
+              关闭
+            </button>
+          </div>
+        </div>
+      )}
+
+      {/* 创建表单 */}
+      {showCreateForm && (
+        <div className="mb-6 p-4 border rounded bg-gray-50">
+          <h2 className="text-lg font-bold mb-4">创建新的 API Key</h2>
+          <form onSubmit={handleCreate} className="space-y-4">
+            <div>
+              <label className="block text-sm font-medium mb-1">名称</label>
+              <input
+                type="text"
+                value={formData.name}
+                onChange={(e) => setFormData({ ...formData, name: e.target.value })}
+                className="w-full px-3 py-2 border rounded"
+                placeholder="例如：生产环境 API Key"
+                required
+              />
+            </div>
+
+            <div>
+              <label className="block text-sm font-medium mb-1">用户 ID</label>
+              <input
+                type="number"
+                value={formData.user_id}
+                onChange={(e) => setFormData({ ...formData, user_id: parseInt(e.target.value) })}
+                className="w-full px-3 py-2 border rounded"
+                required
+              />
+              <p className="text-xs text-gray-500 mt-1">默认 21 为 api_system 系统账号</p>
+            </div>
+
+            <div>
+              <label className="block text-sm font-medium mb-1">权限范围</label>
+              <div className="space-y-2">
+                <label className="flex items-center">
+                  <input
+                    type="checkbox"
+                    checked={formData.scopes.includes('exam:admin')}
+                    onChange={(e) => {
+                      if (e.target.checked) {
+                        setFormData({ ...formData, scopes: [...formData.scopes, 'exam:admin'] })
+                      } else {
+                        setFormData({ ...formData, scopes: formData.scopes.filter(s => s !== 'exam:admin') })
+                      }
+                    }}
+                    className="mr-2"
+                  />
+                  exam:admin（AI 出题管理）
+                </label>
+              </div>
+            </div>
+
+            <div>
+              <label className="block text-sm font-medium mb-1">速率限制（每分钟）</label>
+              <input
+                type="number"
+                value={formData.rate_limit_per_minute}
+                onChange={(e) => setFormData({ ...formData, rate_limit_per_minute: parseInt(e.target.value) })}
+                className="w-full px-3 py-2 border rounded"
+                min="1"
+                max="1000"
+                required
+              />
+            </div>
+
+            <div className="flex gap-2">
+              <button
+                type="submit"
+                className="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700"
+              >
+                创建
+              </button>
+              <button
+                type="button"
+                onClick={() => setShowCreateForm(false)}
+                className="px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700"
+              >
+                取消
+              </button>
+            </div>
+          </form>
+        </div>
+      )}
+
+      {/* API Key 列表 */}
+      <div className="border rounded overflow-hidden">
+        <table className="w-full">
+          <thead className="bg-gray-100">
+            <tr>
+              <th className="px-4 py-2 text-left">名称</th>
+              <th className="px-4 py-2 text-left">Key</th>
+              <th className="px-4 py-2 text-left">权限</th>
+              <th className="px-4 py-2 text-left">速率限制</th>
+              <th className="px-4 py-2 text-left">使用次数</th>
+              <th className="px-4 py-2 text-left">状态</th>
+              <th className="px-4 py-2 text-left">操作</th>
+            </tr>
+          </thead>
+          <tbody>
+            {apiKeys.map((key) => (
+              <tr key={key.id} className="border-t hover:bg-gray-50">
+                <td className="px-4 py-2">{key.name}</td>
+                <td className="px-4 py-2">
+                  <code className="text-sm">{key.key}</code>
+                </td>
+                <td className="px-4 py-2">
+                  <div className="flex flex-wrap gap-1">
+                    {key.scopes.map((scope) => (
+                      <span key={scope} className="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded">
+                        {scope}
+                      </span>
+                    ))}
+                  </div>
+                </td>
+                <td className="px-4 py-2">{key.rate_limit_per_minute}/分钟</td>
+                <td className="px-4 py-2">{key.usage_count}</td>
+                <td className="px-4 py-2">
+                  {key.is_active ? (
+                    <span className="px-2 py-1 bg-green-100 text-green-800 text-xs rounded">激活</span>
+                  ) : (
+                    <span className="px-2 py-1 bg-red-100 text-red-800 text-xs rounded">已撤销</span>
+                  )}
+                </td>
+                <td className="px-4 py-2">
+                  <div className="flex gap-2">
+                    <button
+                      onClick={() => handleViewStats(key)}
+                      className="text-blue-600 hover:underline text-sm"
+                    >
+                      统计
+                    </button>
+                    {key.is_active && (
+                      <button
+                        onClick={() => handleRevoke(key.id)}
+                        className="text-red-600 hover:underline text-sm"
+                      >
+                        撤销
+                      </button>
+                    )}
+                  </div>
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+
+        {apiKeys.length === 0 && (
+          <div className="p-8 text-center text-gray-500">
+            暂无 API Key，点击上方按钮创建
+          </div>
+        )}
+      </div>
+
+      {/* 统计弹窗 */}
+      {selectedKey && stats && (
+        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center">
+          <div className="bg-white rounded-lg p-6 max-w-2xl w-full mx-4">
+            <h2 className="text-xl font-bold mb-4">{selectedKey.name} - 使用统计</h2>
+            <div className="grid grid-cols-2 gap-4 mb-4">
+              <div className="p-4 bg-gray-50 rounded">
+                <div className="text-sm text-gray-600">总请求数</div>
+                <div className="text-2xl font-bold">{stats.total_requests}</div>
+              </div>
+              <div className="p-4 bg-gray-50 rounded">
+                <div className="text-sm text-gray-600">成功数</div>
+                <div className="text-2xl font-bold text-green-600">{stats.success_count}</div>
+              </div>
+              <div className="p-4 bg-gray-50 rounded">
+                <div className="text-sm text-gray-600">失败数</div>
+                <div className="text-2xl font-bold text-red-600">{stats.error_count}</div>
+              </div>
+              <div className="p-4 bg-gray-50 rounded">
+                <div className="text-sm text-gray-600">平均每天请求数</div>
+                <div className="text-2xl font-bold">{stats.avg_requests_per_day.toFixed(2)}</div>
+              </div>
+            </div>
+            <div className="text-sm text-gray-600 mb-4">
+              最后使用时间：{stats.last_used_at ? new Date(stats.last_used_at).toLocaleString('zh-CN') : '从未使用'}
+            </div>
+            <button
+              onClick={() => {
+                setSelectedKey(null)
+                setStats(null)
+              }}
+              className="px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700"
+            >
+              关闭
+            </button>
+          </div>
+        </div>
+      )}
+    </div>
+  )
+}
