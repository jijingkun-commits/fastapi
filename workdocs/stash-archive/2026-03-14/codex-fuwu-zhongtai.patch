+"""API Key 业务逻辑服务。
+
+整合 repository、rate limiter 和 audit log service，提供完整的 API Key 管理功能。
+"""
+from __future__ import annotations
+
+import secrets
+from datetime import datetime
+from typing import Optional
+
+from sqlalchemy.orm import Session
+
+from app.models.api_key import APIKey
+from app.repositories import api_key_repo
+from app.schemas.api_key import (
+    APIKeyCreateRequest,
+    APIKeyListResponse,
+    APIKeyResponse,
+    APIKeyStatsResponse,
+)
+from app.services import audit_log_service
+from app.services.rate_limiter import check_rate_limit
+
+
+def generate_api_key() -> str:
+    """生成 API Key（sk- 前缀 + 32 字节随机字符串）。
+
+    Returns:
+        生成的 API Key
+    """
+    return f"sk-{secrets.token_urlsafe(32)}"
+
+
+def create_api_key(
+    db: Session,
+    request: APIKeyCreateRequest,
+    created_by: int,
+) -> APIKeyResponse:
+    """创建新的 API Key。
+
+    Args:
+        db: 数据库会话
+        request: 创建请求
+        created_by: 创建者ID
+
+    Returns:
+        创建的 API Key 响应（包含完整 key）
+    """
+    # 生成 API Key
+    key = generate_api_key()
+
+    # 转换 scopes 为逗号分隔字符串
+    scopes_str = ",".join(request.scopes)
+
+    # 创建 API Key
+    api_key = api_key_repo.create_api_key(
+        db=db,
+        user_id=request.user_id,
+        key=key,
+        name=request.name,
+        scopes=scopes_str,
+        rate_limit_per_minute=request.rate_limit_per_minute,
+        created_by=created_by,
+        expires_at=request.expires_at,
+    )
+
+    # 返回完整 key（只在创建时返回）
+    return APIKeyResponse.from_orm_with_masked_key(api_key, mask_key=False)
+
+
+def list_api_keys(
+    db: Session,
+    user_id: Optional[int] = None,
+    is_active: Optional[bool] = None,
+    limit: int = 50,
+    offset: int = 0,
+) -> APIKeyListResponse:
+    """查询 API Key 列表。
+
+    Args:
+        db: 数据库会话
+        user_id: 用户ID（可选，None 表示查询所有）
+        is_active: 是否激活（可选，None 表示不过滤）
+        limit: 返回数量限制
+        offset: 偏移量
+
+    Returns:
+        API Key 列表响应
+    """
+    if user_id is not None:
+        items = api_key_repo.get_by_user_id(
+            db=db,
+            user_id=user_id,
+            is_active=is_active,
+            limit=limit,
+            offset=offset,
+        )
+        total = api_key_repo.count_by_user_id(
+            db=db,
+            user_id=user_id,
+            is_active=is_active,
+        )
+    else:
+        items = api_key_repo.list_all(
+            db=db,
+            is_active=is_active,
+            limit=limit,
+            offset=offset,
+        )
+        total = len(items)  # 简化实现，实际应该有单独的 count 方法
+
+    # 转换为响应对象（遮蔽 key）
+    response_items = [
+        APIKeyResponse.from_orm_with_masked_key(item, mask_key=True)
+        for item in items
+    ]
+
+    return APIKeyListResponse(items=response_items, total=total)
+
+
+def get_api_key_by_id(
+    db: Session,
+    api_key_id: int,
+) -> Optional[APIKeyResponse]:
+    """根据 ID 查询 API Key。
+
+    Args:
+        db: 数据库会话
+        api_key_id: API Key ID
+
+    Returns:
+        API Key 响应（遮蔽 key），如果不存在则返回 None
+    """
+    api_key = api_key_repo.get_by_id(db=db, api_key_id=api_key_id)
+    if not api_key:
+        return None
+
+    return APIKeyResponse.from_orm_with_masked_key(api_key, mask_key=True)
+
+
+def revoke_api_key(
+    db: Session,
+    api_key_id: int,
+    revoked_by: int,
+) -> Optional[APIKeyResponse]:
+    """撤销 API Key。
+
+    Args:
+        db: 数据库会话
+        api_key_id: API Key ID
+        revoked_by: 撤销者ID
+
+    Returns:
+        撤销后的 API Key 响应，如果不存在则返回 None
+    """
+    api_key = api_key_repo.revoke_api_key(
+        db=db,
+        api_key_id=api_key_id,
+        revoked_by=revoked_by,
+    )
+    if not api_key:
+        return None
+
+    return APIKeyResponse.from_orm_with_masked_key(api_key, mask_key=True)
+
+
+def verify_api_key(
+    db: Session,
+    key: str,
+) -> tuple[bool, Optional[APIKey], Optional[str]]:
+    """验证 API Key 是否有效。
+
+    Args:
+        db: 数据库会话
+        key: API Key
+
+    Returns:
+        (是否有效, API Key 对象, 失败原因)
+    """
+    # 查询 API Key
+    api_key = api_key_repo.get_by_key(db=db, key=key)
+    if not api_key:
+        return False, None, "API Key 不存在"
+
+    # 检查是否激活
+    if not api_key.is_active:
+        return False, api_key, "API Key 已被撤销"
+
+    # 检查是否过期
+    if api_key.expires_at and api_key.expires_at < datetime.now():
+        return False, api_key, "API Key 已过期"
+
+    # 检查速率限制
+    if not check_rate_limit(api_key.id, api_key.rate_limit_per_minute):
+        return False, api_key, "超过速率限制"
+
+    # 更新最后使用时间
+    api_key_repo.update_last_used(db=db, api_key_id=api_key.id)
+
+    return True, api_key, None
+
+
+def get_usage_stats(
+    db: Session,
+    api_key_id: int,
+    start_date: Optional[datetime] = None,
+    end_date: Optional[datetime] = None,
+) -> APIKeyStatsResponse:
+    """查询 API Key 使用统计。
+
+    Args:
+        db: 数据库会话
+        api_key_id: API Key ID
+        start_date: 开始日期（可选）
+        end_date: 结束日期（可选）
+
+    Returns:
+        使用统计响应
+    """
+    stats = audit_log_service.get_usage_stats(
+        db=db,
+        api_key_id=api_key_id,
+        start_date=start_date,
+        end_date=end_date,
+    )
+
+    return APIKeyStatsResponse(**stats)
