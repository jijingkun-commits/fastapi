+"""审计日志服务。
+
+异步记录 API Key 使用，写入失败不阻塞主请求。
+"""
+from __future__ import annotations
+
+import logging
+from datetime import datetime, timedelta
+from typing import Optional
+
+from sqlalchemy import and_, func
+from sqlalchemy.orm import Session
+
+from app.models.api_key import APIKeyAuditLog
+
+logger = logging.getLogger(__name__)
+
+
+def record_api_key_usage(
+    db: Session,
+    api_key_id: int,
+    user_id: int,
+    request_url: str,
+    request_method: str,
+    response_status: int,
+) -> None:
+    """记录 API Key 使用（异步写入）。
+
+    Args:
+        db: 数据库会话
+        api_key_id: API Key ID
+        user_id: 用户ID
+        request_url: 请求URL
+        request_method: 请求方法
+        response_status: 响应状态码
+    """
+    try:
+        audit_log = APIKeyAuditLog(
+            api_key_id=api_key_id,
+            user_id=user_id,
+            request_url=request_url,
+            request_method=request_method,
+            response_status=response_status,
+            created_at=datetime.now(),
+        )
+        db.add(audit_log)
+        db.commit()
+    except Exception as e:
+        logger.error(f"审计日志写入失败: {e}")
+        db.rollback()
+        # 写入失败不抛出异常，不阻塞主请求
+
+
+def get_usage_stats(
+    db: Session,
+    api_key_id: int,
+    start_date: Optional[datetime] = None,
+    end_date: Optional[datetime] = None,
+) -> dict:
+    """查询 API Key 使用统计。
+
+    Args:
+        db: 数据库会话
+        api_key_id: API Key ID
+        start_date: 开始日期（可选）
+        end_date: 结束日期（可选）
+
+    Returns:
+        使用统计字典
+    """
+    # 默认查询最近 30 天
+    if not start_date:
+        start_date = datetime.now() - timedelta(days=30)
+    if not end_date:
+        end_date = datetime.now()
+
+    # 查询总请求数
+    query = db.query(APIKeyAuditLog).filter(
+        and_(
+            APIKeyAuditLog.api_key_id == api_key_id,
+            APIKeyAuditLog.created_at >= start_date,
+            APIKeyAuditLog.created_at <= end_date,
+        )
+    )
+
+    total_requests = query.count()
+
+    # 查询成功数（2xx 状态码）
+    success_count = query.filter(
+        and_(
+            APIKeyAuditLog.response_status >= 200,
+            APIKeyAuditLog.response_status < 300,
+        )
+    ).count()
+
+    # 查询失败数（4xx, 5xx 状态码）
+    error_count = query.filter(APIKeyAuditLog.response_status >= 400).count()
+
+    # 查询最后使用时间
+    last_log = (
+        query.order_by(APIKeyAuditLog.created_at.desc()).first()
+    )
+    last_used_at = last_log.created_at if last_log else None
+
+    # 计算平均每天请求数
+    days = (end_date - start_date).days or 1
+    avg_requests_per_day = total_requests / days
+
+    return {
+        "api_key_id": api_key_id,
+        "total_requests": total_requests,
+        "success_count": success_count,
+        "error_count": error_count,
+        "avg_requests_per_day": round(avg_requests_per_day, 2),
+        "last_used_at": last_used_at,
+    }
+
+
+def get_recent_logs(
+    db: Session,
+    api_key_id: int,
+    limit: int = 100,
+) -> list[APIKeyAuditLog]:
+    """查询最近的审计日志。
+
+    Args:
+        db: 数据库会话
+        api_key_id: API Key ID
+        limit: 返回数量限制
+
+    Returns:
+        审计日志列表
+    """
+    return (
+        db.query(APIKeyAuditLog)
+        .filter(APIKeyAuditLog.api_key_id == api_key_id)
+        .order_by(APIKeyAuditLog.created_at.desc())
+        .limit(limit)
+        .all()
+    )
