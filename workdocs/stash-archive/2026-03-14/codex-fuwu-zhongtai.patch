+def get_current_user(token: str = Depends(oauth2_scheme), db: Session = Depends(get_db)):
+    """根据 Bearer Token 或 API Key 解析当前用户（双轨认证）。
+
+    验证流程：
+    1. 判断 token 前缀：
+       - sk- 开头：API Key 认证
+       - 其他：JWT Token 认证
+    2. API Key 认证流程：
+       - 验证 API Key 有效性
+       - 检查速率限制
+       - 检查关联用户
+    3. JWT Token 认证流程（原有逻辑）：
+       - 解析 Token 并验证签名
+       - 检查 Token 是否在黑名单中
+       - 检查用户是否存在
+       - 检查用户是否被禁用
+    """
+    # 判断认证方式
+    if token.startswith("sk-"):
+        # API Key 认证
+        is_valid, user, reason, scopes = authenticate_by_api_key(db=db, api_key=token)
+        if not is_valid:
+            raise HTTPException(
+                status_code=status.HTTP_401_UNAUTHORIZED,
+                detail=reason or "API Key 认证失败",
+            )
+
+        # 将 scopes 附加到 user 对象（用于后续权限校验）
+        user.api_key_scopes = scopes
+        return user
+    else:
+        # JWT Token 认证（原有逻辑）
+        valid, payload = is_token_valid(db, token)
+        if not valid:
+            raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="无效令牌")
+
+        try:
+            uid = int(payload.get("uid"))
+        except (TypeError, ValueError):
+            raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="无效令牌")
+
+        user = get_by_id(db, uid)
+        if not user:
+            raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="用户不存在")
+        if not user.is_active:
+            raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="用户已被禁用")
+
+        # JWT Token 认证的用户没有 scopes 限制
+        user.api_key_scopes = None
+        return user
+
+
+def require_scope(required_scope: str) -> Callable:
+    """权限范围装饰器，用于校验 API Key 权限。
+
+    Args:
+        required_scope: 必需的权限范围（如 "exam:admin"）
+
+    Returns:
+        装饰器函数
+
+    使用示例：
+        @router.post("/api/v1/admin/exam/jobs")
+        @require_scope("exam:admin")
+        async def create_job(user: User = Depends(get_current_user)):
+            ...
+    """
+    def decorator(func: Callable) -> Callable:
+        @wraps(func)
+        async def wrapper(*args, **kwargs):
+            # 从 kwargs 中获取 user 对象
+            user = kwargs.get("user") or kwargs.get("current_user")
+            if not user:
+                raise HTTPException(
+                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
+                    detail="权限校验失败：无法获取用户对象",
+                )
+
+            # 如果是 JWT Token 认证，跳过权限校验（JWT Token 用户拥有所有权限）
+            if not hasattr(user, "api_key_scopes") or user.api_key_scopes is None:
+                return await func(*args, **kwargs)
+
+            # 如果是 API Key 认证，校验权限范围
+            if required_scope not in user.api_key_scopes:
+                raise HTTPException(
+                    status_code=status.HTTP_403_FORBIDDEN,
+                    detail=f"权限不足：需要 {required_scope} 权限",
+                )
+
+            return await func(*args, **kwargs)
+
+        return wrapper
+
+    return decorator
 
 
