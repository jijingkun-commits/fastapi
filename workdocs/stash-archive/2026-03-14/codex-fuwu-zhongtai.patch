+/**
+ * API Key 管理 API 调用封装
+ */
+
+import { getAuthHeaders } from './auth'
+
+const API_BASE = process.env.NEXT_PUBLIC_API_BASE_URL || 'http://localhost:8000'
+
+export interface APIKeyCreateRequest {
+  name: string
+  user_id: number
+  scopes: string[]
+  rate_limit_per_minute?: number
+  expires_at?: string
+}
+
+export interface APIKeyResponse {
+  id: number
+  user_id: number
+  key: string
+  name: string
+  scopes: string[]
+  rate_limit_per_minute: number
+  usage_count: number
+  last_used_at: string | null
+  is_active: boolean
+  expires_at: string | null
+  created_at: string
+  created_by: number
+  revoked_at: string | null
+  revoked_by: number | null
+}
+
+export interface APIKeyListResponse {
+  items: APIKeyResponse[]
+  total: number
+}
+
+export interface APIKeyStatsResponse {
+  api_key_id: number
+  total_requests: number
+  success_count: number
+  error_count: number
+  avg_requests_per_day: number
+  last_used_at: string | null
+}
+
+export interface APIKeyAuditLog {
+  id: number
+  api_key_id: number
+  user_id: number
+  request_url: string
+  request_method: string
+  response_status: number
+  created_at: string
+}
+
+/**
+ * 创建 API Key
+ */
+export async function createAPIKey(request: APIKeyCreateRequest): Promise<APIKeyResponse> {
+  const response = await fetch(`${API_BASE}/api/v1/admin/api-keys`, {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+      ...getAuthHeaders(),
+    },
+    body: JSON.stringify(request),
+  })
+
+  if (!response.ok) {
