+ def evaluate_paper_contract(paper: PaperContract) -> ExamQualityReport:
+-    issues: list[ExamQualityIssue] = []
+-    duplicate_count = 0
+-    evidence_missing_count = 0
+-    normalized_stems = [re.sub(r"\s+", "", item.stem) for item in paper.questions]
