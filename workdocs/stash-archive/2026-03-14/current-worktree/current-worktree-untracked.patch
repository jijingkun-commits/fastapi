+++def build_research_result_payload(
+++    *,
+++    research_mode: Any,
+++    research_task_id: Any,
+++    summary: Any,
+++    evidence: Any,
+++    insufficiency: Any,
+++    source_count: Any = None,
+++    citation_count: Any = None,
+++    contract_version: Any = "v1",
+++) -> ResearchResultPayload:
+++    """构建 stateless research 结果合同。"""
+++
+++    normalized_evidence: List[ResearchEvidencePayload] = []
+++    seen_pairs: Set[Tuple[str, str]] = set()
+++    if isinstance(evidence, list):
+++        for item in evidence:
+++            if isinstance(item, dict):
+++                source = str(item.get("source") or "").strip() or "unknown"
+++                excerpt = str(item.get("excerpt") or "").strip()
+++            else:
+++                source = "unknown"
+++                excerpt = str(item or "").strip()
+++            if not excerpt:
+++                continue
+++            pair = (source, excerpt)
+++            if pair in seen_pairs:
+++                continue
+++            seen_pairs.add(pair)
+++            normalized_evidence.append({"source": source, "excerpt": excerpt})
+++
+++    def _normalize_non_negative_int(value: Any, default: int) -> int:
+++        try:
+++            parsed = int(value)
+++        except (TypeError, ValueError):
+++            return default
+++        return max(parsed, 0)
+++
+++    normalized_summary = str(summary or "").strip()
+++    normalized_insufficiency = str(insufficiency or "").strip()
+++    normalized_mode = str(research_mode or "").strip() or "research"
+++    normalized_task_id = str(research_task_id or "").strip() or f"{normalized_mode}:unknown"
+++    normalized_contract_version = str(contract_version or "").strip() or "v1"
+++
+++    inferred_source_count = len({item["source"] for item in normalized_evidence})
+++    return {
+++        "contract_version": normalized_contract_version,
+++        "research_mode": normalized_mode,
+++        "research_task_id": normalized_task_id,
+++        "summary": normalized_summary,
+++        "evidence": normalized_evidence,
+++        "insufficiency": normalized_insufficiency,
+++        "source_count": _normalize_non_negative_int(source_count, inferred_source_count),
+++        "citation_count": _normalize_non_negative_int(citation_count, 0),
+++    }
