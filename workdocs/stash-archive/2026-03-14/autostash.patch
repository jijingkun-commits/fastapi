+def _route_after_generation(state: PaperWorkflowState) -> Literal["gate", "repair", "postprocess"]:
+    decision = str(state.get("paper_decision") or "")
+    if decision == "generated":
+        return "gate"
+    if decision == "needs_repair" and int(state.get("repair_round") or 0) < int(state.get("max_repair_rounds") or 2):
+        return "repair"
+    return "postprocess"
+
+
+def _route_after_gate(state: PaperWorkflowState) -> Literal["repair", "postprocess"]:
+    if str(state.get("paper_decision") or "") == "approved":
+        return "postprocess"
+    if int(state.get("repair_round") or 0) < int(state.get("max_repair_rounds") or 2):
+        return "repair"
+    return "postprocess"
+
+
+def _route_after_repair(state: PaperWorkflowState) -> Literal["plan", "postprocess"]:
+    if str(state.get("paper_decision") or "") == "failed":
+        return "postprocess"
+    return "plan"
+
