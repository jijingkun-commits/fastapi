+def _build_paper_generation_graph():
+    workflow = StateGraph(PaperWorkflowState)
+    workflow.add_node("preprocess", _paper_preprocess)
+    workflow.add_node("materialize", _materialize_generation_context)
+    workflow.add_node("plan", _plan_questions)
+    workflow.add_node("generate", _generate_questions)
+    workflow.add_node("gate", _gate_paper)
+    workflow.add_node("repair", _repair_questions_or_paper)
+    workflow.add_node("postprocess", _paper_postprocess)
+
+    workflow.add_edge(START, "preprocess")
+    workflow.add_edge("preprocess", "materialize")
+    workflow.add_edge("materialize", "plan")
+    workflow.add_edge("plan", "generate")
+    workflow.add_conditional_edges(
+        "generate",
+        _route_after_generation,
+        {
+            "gate": "gate",
+            "repair": "repair",
+            "postprocess": "postprocess",
+        },
     )
+    workflow.add_conditional_edges(
+        "gate",
+        _route_after_gate,
+        {
+            "repair": "repair",
+            "postprocess": "postprocess",
+        },
+    )
+    workflow.add_conditional_edges(
+        "repair",
+        _route_after_repair,
