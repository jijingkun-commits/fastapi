+function resolveDownloadFilename(contentDisposition: string | null, fallback: string): string {
+  if (!contentDisposition) return fallback;
+  const utf8Match = contentDisposition.match(/filename\*\s*=\s*utf-8''([^;]+)/i);
+  if (utf8Match?.[1]) {
+    return decodeURIComponent(utf8Match[1]).replace(/^"(.*)"$/, '$1');
+  }
+  const filenameMatch = contentDisposition.match(/filename\s*=\s*"?([^"]+)"?/i);
+  return filenameMatch?.[1] || fallback;
+}
+
+export async function downloadExamJob(jobId: number, format: 'zip' | 'md' | 'pdf' = 'zip'): Promise<void> {
+  const suffix = format === 'zip' ? '' : `?format=${format}`;
+  const response = await apiFetch(`${API_BASE}/jobs/${jobId}/download${suffix}`);
+  if (!response.ok) throw new Error(await readErrorMessage(response, '下载题包失败'));
+
+  const blob = await response.blob();
+  const filename = resolveDownloadFilename(
+    response.headers.get('content-disposition'),
+    `exam-job-${jobId}.${format === 'md' ? 'md' : format}`,
+  );
+  const objectUrl = window.URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = objectUrl;
+  link.download = filename;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  window.setTimeout(() => window.URL.revokeObjectURL(objectUrl), 0);
 }
