@@ -0,0 +1,195 @@
+"use client";
+
+import Image from "next/image";
+import { useEffect, useState } from "react";
+import { X as XIcon } from "lucide-react";
+
+import { ImageLightbox } from "@/components/ui/image-viewer";
+import { cn } from "@/lib/utils";
+
+const MESSAGE_MAX_WIDTH = 320;
+const MESSAGE_MAX_HEIGHT = 192;
+
+const COMPOSER_PRESET_CONFIG = {
+  "composer-sm": {
+    boxClassName: "h-10 w-10",
+    size: 40,
+  },
+  "composer-md": {
+    boxClassName: "h-16 w-16",
+    size: 64,
+  },
+  "composer-lg": {
+    boxClassName: "h-24 w-24",
+    size: 96,
+  },
+} as const;
+
+export type ChatImageThumbnailPreset =
+  | "message"
+  | keyof typeof COMPOSER_PRESET_CONFIG;
+
+interface ChatImageThumbnailProps {
+  src?: string;
+  alt?: string;
+  preset?: ChatImageThumbnailPreset;
+  className?: string;
+  removable?: boolean;
+  onRemove?: () => void;
+}
+
+function fitMessageThumbnailSize(
+  width: number,
+  height: number,
+): { width: number; height: number } {
+  if (width <= 0 || height <= 0) {
+    return {
+      width: MESSAGE_MAX_WIDTH,
+      height: MESSAGE_MAX_HEIGHT,
+    };
+  }
+
+  const scale = Math.min(MESSAGE_MAX_WIDTH / width, MESSAGE_MAX_HEIGHT / height);
+
+  return {
+    width: Math.max(1, Math.round(width * scale)),
+    height: Math.max(1, Math.round(height * scale)),
+  };
+}
+
+function renderRemoveButton(onRemove?: () => void) {
+  if (!onRemove) {
+    return null;
+  }
+
+  return (
+    <button
+      type="button"
+      className="absolute top-1 right-1 z-10 rounded-full bg-gray-500 text-white hover:bg-gray-700"
+      onClick={(event) => {
+        event.stopPropagation();
+        onRemove();
+      }}
+      aria-label="移除图片"
+    >
+      <XIcon className="h-4 w-4" />
+    </button>
+  );
+}
+
+export function ChatImageThumbnail({
+  src,
+  alt,
+  preset = "message",
+  className,
+  removable = false,
+  onRemove,
+}: ChatImageThumbnailProps) {
+  const [lightboxOpen, setLightboxOpen] = useState(false);
+  const [loadError, setLoadError] = useState(false);
+  const [messageSize, setMessageSize] = useState(() =>
+    fitMessageThumbnailSize(MESSAGE_MAX_WIDTH, MESSAGE_MAX_HEIGHT),
+  );
+  const imageName = alt || "图片";
+
+  useEffect(() => {
+    setLoadError(false);
+    setLightboxOpen(false);
+    setMessageSize(fitMessageThumbnailSize(MESSAGE_MAX_WIDTH, MESSAGE_MAX_HEIGHT));
+  }, [preset, src]);
+
+  if (!src) {
+    return null;
+  }
+
+  if (loadError) {
+    return (
+      <div
+        className={cn(
+          "relative inline-flex items-center gap-2 rounded-md border border-dashed px-3 py-2 text-xs text-gray-400",
+          className,
+        )}
+        data-chat-image-preset={preset}
+      >
+        <span>[图片加载失败]</span>
+        {removable ? renderRemoveButton(onRemove) : null}
+      </div>
+    );
+  }
+
+  if (preset === "message") {
+    return (
+      <>
+        <div
+          className={cn("relative inline-block align-top", className)}
+          data-chat-image-preset={preset}
+        >
+          <Image
+            src={src}
+            alt={imageName}
+            width={messageSize.width}
+            height={messageSize.height}
+            unoptimized
+            className="my-2 h-auto w-auto max-w-full cursor-pointer rounded-lg border shadow-sm transition-opacity hover:opacity-90"
+            loading="lazy"
+            onClick={() => setLightboxOpen(true)}
+            onLoad={(event) => {
+              setLoadError(false);
+              setMessageSize(
+                fitMessageThumbnailSize(
+                  event.currentTarget.naturalWidth,
+                  event.currentTarget.naturalHeight,
+                ),
+              );
+            }}
+            onError={() => setLoadError(true)}
+          />
+          {removable ? renderRemoveButton(onRemove) : null}
+        </div>
+
+        <ImageLightbox
+          open={lightboxOpen}
+          onOpenChange={setLightboxOpen}
+          src={src}
+          alt={imageName}
+        />
+      </>
+    );
+  }
+
+  const composerPreset = COMPOSER_PRESET_CONFIG[preset];
+
+  return (
+    <>
+      <div
+        className={cn(
+          "relative inline-flex items-center justify-center overflow-hidden rounded-md border bg-gray-50",
+          composerPreset.boxClassName,
+          className,
+        )}
+        data-chat-image-preset={preset}
+      >
+        <Image
+          src={src}
+          alt={imageName}
+          width={composerPreset.size}
+          height={composerPreset.size}
+          unoptimized
+          className="h-full w-full cursor-pointer object-contain transition-opacity hover:opacity-80"
+          loading="lazy"
+          onClick={() => setLightboxOpen(true)}
+          onLoad={() => setLoadError(false)}
+          onError={() => setLoadError(true)}
+        />
+        {removable ? renderRemoveButton(onRemove) : null}
+      </div>
+
+      <ImageLightbox
+        open={lightboxOpen}
+        onOpenChange={setLightboxOpen}
+        src={src}
+        alt={imageName}
+      />
+    </>
+  );
+}
