@@ -0,0 +1,31 @@
+"""turn_intent_resolver 结构化语义合同测试。"""
+
+from app.ai.intent.turn_intent_resolver import resolve_turn_intent
+
+
+def test_resolve_turn_intent_should_treat_question_like_followup_as_challenge() -> None:
+    """带 prior context 的问号追问应视为 follow-up challenge，而不是新问题。"""
+    contract = resolve_turn_intent(
+        "为什么数据不全？",
+        has_prior_context=True,
+        baseline_frame={"metric": "贷款余额"},
+    )
+
+    assert contract.turn_act == "FOLLOW_UP_CHALLENGE"
+    assert contract.goal_action == "INHERIT"
+    assert contract.reason_code == "question_like_with_prior_context"
+    assert contract.needs_clarification is False
+
+
+def test_resolve_turn_intent_should_keep_structured_data_supplement_as_inherit() -> None:
+    """补图/补时间等结构化补充轮应继承原有 goals。"""
+    contract = resolve_turn_intent(
+        "按月看",
+        has_prior_context=True,
+        baseline_frame={"metric": "贷款余额"},
+    )
+
+    assert contract.turn_act == "FOLLOW_UP_SUPPLEMENT"
+    assert contract.goal_action == "INHERIT"
+    assert contract.reason_code == "structured_followup_frame"
+    assert contract.slot_deltas["dimensions"] == ["日期"]
