+"""二轮追问语义 resolver。"""
+
+from __future__ import annotations
+
+import re
+from typing import Any, Dict, Optional
+
+from app.ai.contracts.turn_intent_contracts import TurnIntentContract
+
+
+_SHORT_CONFIRM_TEXTS = {"好", "好的", "行", "可以", "确认", "对", "嗯", "ok", "OK"}
+
+
+def _normalize_text(value: Any) -> str:
+    return str(value or "").strip()
+
+
+def _normalize_text_list(value: Any) -> list[str]:
+    if isinstance(value, list):
+        return [str(item).strip() for item in value if str(item).strip()]
+    if isinstance(value, tuple):
+        return [str(item).strip() for item in value if str(item).strip()]
+    if isinstance(value, str):
+        text = value.strip()
+        return [text] if text else []
+    return []
+
+
+def _normalize_session_frame(frame: Optional[Dict[str, Any]]) -> Dict[str, Any]:
+    raw = frame if isinstance(frame, dict) else {}
+    return {
+        "metric": _normalize_text(raw.get("metric") or raw.get("metric_name")),
+        "time_range": _normalize_text(raw.get("time_range")),
+        "dimensions": _normalize_text_list(raw.get("dimensions")),
+        "org_level": _normalize_text(raw.get("org_level")),
+        "chart_type": _normalize_text(raw.get("chart_type")),
+        "filters": _normalize_text_list(raw.get("filters")),
+        "query_shape": _normalize_text(raw.get("query_shape")),
+        "todo_action": _normalize_text(raw.get("todo_action") or raw.get("action")),
+        "todo_target_id": _normalize_text(raw.get("todo_target_id") or raw.get("todo_id")),
+        "todo_fields": dict(raw.get("todo_fields")) if isinstance(raw.get("todo_fields"), dict) else {},
+    }
+
+
+def _compact_text(text: Any) -> str:
+    return re.sub(r"\s+", "", _normalize_text(text))
+
+
+def _extract_chart_type_hint(text: str) -> str:
+    compact = _compact_text(text)
+    if not compact:
+        return ""
+
+    match = re.search(r"(柱状图|柱形图|条形图|饼图|折线图)", compact)
+    if not match:
+        return ""
+    detected = match.group(1)
+    if detected in {"柱形图", "条形图"}:
+        return "柱状图"
+    return detected
+
+
+def _extract_time_range_hint(text: str) -> str:
+    compact = _compact_text(text)
+    if not compact:
+        return ""
+
+    absolute_match = re.search(
+        r"((?:19|20)\d{2}(?:[-/.年]\d{1,2}){1,2}(?:日)?)",
+        compact,
+    )
+    if absolute_match:
+        return absolute_match.group(1)
+
+    relative_match = re.search(
+        r"(今(?:天|日)|昨天|昨日|本周|上周|本月|上月|本季度|上季度|今年|去年|(?:近|最近|过去)\d+(?:天|周|月|季度|年))",
+        compact,
+    )
+    if relative_match:
+        return relative_match.group(1)
+
+    return ""
+
+
+def _extract_dimension_hints(text: str) -> list[str]:
+    compact = _compact_text(text)
+    if not compact or "总体" in compact or "汇总" in compact:
+        return []
+
+    dimensions: list[str] = []
+    if any(token in compact for token in ("日期", "按天", "按月", "趋势")):
+        dimensions.append("日期")
+    if "机构" in compact:
+        dimensions.append("机构")
+    if "客户" in compact:
+        dimensions.append("客户")
+    if "分行" in compact:
+        dimensions.append("分行")
+    if "支行" in compact:
+        dimensions.append("支行")
+    return dimensions
+
+
+def _extract_org_level_hint(text: str) -> str:
+    compact = _compact_text(text)
+    if "支行" in compact:
+        return "支行"
+    if "分行" in compact:
+        return "分行"
+    if "总行" in compact:
+        return "总行"
+    return ""
+
+
+def _extract_filter_hints(text: str) -> list[str]:
+    compact = _compact_text(text)
+    if not compact:
+        return []
+    if any(token in compact for token in ("仅看", "只看", "筛选", "过滤", "排除", "限定")):
+        return [compact]
+    return []
+
+
+def _infer_session_frame_from_text(text: str) -> Dict[str, Any]:
+    compact = _compact_text(text)
+    if not compact:
+        return _normalize_session_frame(None)
+    return _normalize_session_frame(
+        {
+            "time_range": _extract_time_range_hint(compact),
+            "dimensions": _extract_dimension_hints(compact),
+            "org_level": _extract_org_level_hint(compact),
+            "chart_type": _extract_chart_type_hint(compact),
+            "filters": _extract_filter_hints(compact),
+        }
+    )
+
+
+def _slot_deltas_from_frame(frame: Dict[str, Any]) -> Dict[str, Any]:
+    slot_deltas: Dict[str, Any] = {}
+    for key, value in frame.items():
+        if isinstance(value, str) and value.strip():
+            slot_deltas[key] = value.strip()
+        elif isinstance(value, list) and value:
+            slot_deltas[key] = list(value)
+        elif isinstance(value, dict) and value:
+            slot_deltas[key] = dict(value)
+    return slot_deltas
+
+
+def _has_structured_followup_signal(frame: Dict[str, Any]) -> bool:
+    return any(
+        [
+            str(frame.get("chart_type") or "").strip(),
+            str(frame.get("org_level") or "").strip(),
+            str(frame.get("time_range") or "").strip(),
+            bool(frame.get("dimensions")),
+            bool(frame.get("filters")),
+            bool(frame.get("todo_fields")),
+            str(frame.get("todo_target_id") or "").strip(),
+        ]
+    )
+
+
+def resolve_turn_intent(
+    text: str,
+    *,
+    has_prior_context: bool,
+    baseline_frame: Optional[Dict[str, Any]] = None,
+    current_frame: Optional[Dict[str, Any]] = None,
+) -> TurnIntentContract:
+    """基于上下文和当前轮结构化 frame 生成语义合同。"""
+    compact = _compact_text(text)
+    if not compact:
