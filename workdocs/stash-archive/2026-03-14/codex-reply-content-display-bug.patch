+"""二轮追问语义合同。"""
+
+from __future__ import annotations
+
+from typing import Any, Dict, List, Literal
+
+from pydantic import BaseModel, Field
+
+
+TurnAct = Literal[
+    "NEW_QUERY",
+    "FOLLOW_UP_SUPPLEMENT",
+    "FOLLOW_UP_CHALLENGE",
+    "CORRECTION",
+    "CONFIRM",
+    "CLARIFY",
+]
+
+GoalAction = Literal[
+    "REBUILD",
+    "INHERIT",
+    "INHERIT_AND_EXTEND",
+    "HOLD",
+    "CLARIFY",
+]
+
+SemanticSource = Literal[
+    "model_primary",
+    "context_guard",
+    "fallback_clarify",
+]
+
+
+class TurnIntentContract(BaseModel):
+    """当前轮语义合同。"""
+
+    turn_act: TurnAct
+    goal_action: GoalAction
+    reason_code: str = Field(min_length=1)
+    confidence: float = Field(ge=0.0, le=1.0, default=0.0)
+    needs_clarification: bool = False
+    semantic_source: SemanticSource = "context_guard"
+    proposed_goals: List[Dict[str, Any]] = Field(default_factory=list)
+    slot_deltas: Dict[str, Any] = Field(default_factory=dict)
