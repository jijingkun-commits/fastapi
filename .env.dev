DATABASE_URL=mysql+pymysql://root:1@127.0.0.1:13006/chat_db
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
INIT_DB_ON_STARTUP=true
LOG_LEVEL=DEBUG
LOG_FILE=logs/assistant.log
LOG_ROTATE_WHEN=midnight
LOG_ROTATE_INTERVAL=1
LOG_BACKUP_COUNT=5
LOG_COLORIZE=true
ENV=dev
CORS_ALLOW_ORIGINS=*
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_ECHO=true
