# ============================================================
# RAGFlow 企业知识库配置
# ============================================================
# RAGFlow 服务地址（Docker 部署时使用内部地址，本地开发时使用 localhost）
# Docker 部署: http://ragflow-server:80
# 本地开发: http://localhost:9380
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_URL=http://localhost:9380/api/v1
# RAGFlow API Key（在 RAGFlow 用户设置中获取）
RAGFLOW_API_KEY=ragflow-Ntr71mkL76PdRlwtMz75kbeRE37WIhUj-QY1pnhGPIM
# 默认知识库 ID（在 RAGFlow 知识库页面获取）
RAGFLOW_DATASET_IDS=7c112617e91411f08852712b5dc403b8,7ada1afbeac811f0a8c5712b5dc403b8
# 检索相似度阈值（0-1，越高越严格）
RAGFLOW_SIMILARITY_THRESHOLD=0.2
# 检索返回的最大文档数
RAGFLOW_TOP_K=5
# 向量相似度权重（0-1，向量占比，剩余为关键词占比）
# 混合相似度 = 向量相似度 × weight + 关键词相似度 × (1 - weight)
RAGFLOW_VECTOR_WEIGHT=0.3

# MCP Chart 图表服务
MCP_CHART_SERVER_URL="http://localhost:1122/sse"
MCP_CHART_ENABLED="true"
